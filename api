export default async function handler(req, res) {
  // Only allow POST
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const ANTHROPIC_API_KEY = process.env.ANTHROPIC_API_KEY;
  const PROJECT_ID = 'proj_Rv3aAAu49zkuEmkOhAlhLQ';
  const DOC_ID     = 'doc_wHbr7d396DWCz-pECowXWQ';
  const MODEL      = 'claude-sonnet-4-20250514';
  const MCP        = [{ type: 'url', url: 'https://brain.thebaascompany.com/ai/mcp', name: 'the-brain' }];

  try {
    const state = req.body;
    const today = new Date().toISOString().split('T')[0];
    const content = `# Board State — Live\n# The BaaS Company | Leoni Janssen\n# Last updated: ${today}\n# Schema version: 3.0\n\n\`\`\`json\n${JSON.stringify(state, null, 2)}\n\`\`\``;

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01',
        'anthropic-beta': 'mcp-client-1.0'
      },
      body: JSON.stringify({
        model: MODEL,
        max_tokens: 400,
        system: 'You are a Brain document update agent. Use the Brain MCP update_document tool to update the specified document with the exact text content provided. Reply with just "SAVED".',
        messages: [{
          role: 'user',
          content: `Update document ${DOC_ID} in project ${PROJECT_ID} with this exact content:\n\n${content}`
        }],
        mcp_servers: MCP
      })
    });

    const data = await response.json();
    if (!response.ok) {
      return res.status(500).json({ error: 'Anthropic API error', detail: data });
    }

    return res.status(200).json({ ok: true });
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
}
