export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });

  const ANTHROPIC_API_KEY = process.env.ANTHROPIC_API_KEY;
  if (!ANTHROPIC_API_KEY) return res.status(500).json({ error: 'Missing ANTHROPIC_API_KEY' });

  const PROJECT_ID = 'proj_Rv3aAAu49zkuEmkOhAlhLQ';
  const DOC_ID     = 'doc_wHbr7d396DWCz-pECowXWQ';
  const MODEL      = 'claude-sonnet-4-20250514';

  try {
    const state = req.body;
    const today = new Date().toISOString().split('T')[0];
    const textContent = `# Board State — Live\n# The BaaS Company | Leoni Janssen\n# Last updated: ${today}\n# Schema version: 3.0\n\n\`\`\`json\n${JSON.stringify(state, null, 2)}\n\`\`\``;

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01',
        'anthropic-beta': 'mcp-client-1.0'
      },
      body: JSON.stringify({
        model: MODEL,
        max_tokens: 500,
        system: 'You are a Brain document update agent. Use the update_document Brain MCP tool to update the document. Reply with just "SAVED" when done.',
        messages: [{
          role: 'user',
          content: `Use the Brain MCP tool update_document to update document_id="${DOC_ID}" in project_id="${PROJECT_ID}" with operation="replace_with_text" and this exact text_content:\n\n${textContent}\n\nReply with just "SAVED".`
        }],
        mcp_servers: [{
          type: 'url',
          url: 'https://brain.thebaascompany.com/ai/mcp',
          name: 'the-brain'
        }]
      })
    });

    const data = await response.json();

    if (!response.ok) {
      console.error('Anthropic error:', JSON.stringify(data));
      return res.status(500).json({ error: 'Anthropic API error', detail: data });
    }

    return res.status(200).json({ ok: true, response: data });
  } catch (err) {
    console.error('Handler error:', err);
    return res.status(500).json({ error: err.message });
  }
}
